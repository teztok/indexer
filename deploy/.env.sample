# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# ---- image tag to run -------------------------------------------------------
# The only line you change to deploy or roll back. Use an immutable tag
# (v1.2.3 or sha-abc1234), never "latest" -- "latest" cannot be rolled back and
# gives you no way to tell what is actually running.
INDEXER_TAG=v0.0.0

# ---- database ---------------------------------------------------------------
# POSTGRES_HOST must match the database service name in docker-compose.yml.
POSTGRES_USER=teztok
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_DB=teztok
POSTGRES_HOST=teztok_database

# The backup/restore image requires POSTGRES_DATABASE; the app reads POSTGRES_DB.
# Both must be set, to the same value.
POSTGRES_DATABASE=teztok

# ---- chain data -------------------------------------------------------------
# A self-hosted tzkt instance is strongly preferred for a full index; the public
# endpoint will rate limit a catch-up run.
TZKT_API=https://api.mainnet.tzkt.io/v1

# ---- ipfs / metadata --------------------------------------------------------
# Comma-separated list allowed. Use a gateway that tolerates heavy traffic.
IPFS_GATEWAY=change_me
THUMBNAIL_IPFS_GATEWAY=change_me
ONCHFS_GATEWAY=https://onchfs.fxhash2.xyz
FETCH_METADATA_TIMEOUT=40000

PINNING_ENDPOINT=change_me
PINNING_ENDPOINT_ACCESS_TOKEN=change_me
INFURA_PROJECT_ID=change_me
INFURA_PROJECT_SECRET=change_me

# ---- thumbnail warmup -------------------------------------------------------
IMGPROXY_SALT=change_me
IMGPROXY_SECRET=change_me
IMGPROXY_WARMUP_ENDPOINT=change_me

# ---- hasura -----------------------------------------------------------------
HASURA_GRAPHQL_DATABASE_URL=postgres://teztok:change_me@teztok_database:5432/teztok
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://teztok:change_me@teztok_database:5432/teztok
PG_DATABASE_URL=postgres://teztok:change_me@teztok_database:5432/teztok
HASURA_GRAPHQL_ENABLE_CONSOLE=false
HASURA_GRAPHQL_DEV_MODE=false
HASURA_GRAPHQL_ENABLED_LOG_TYPES="startup, http-log, webhook-log, websocket-log"
HASURA_GRAPHQL_ADMIN_SECRET=change_me
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=webuser

# ---- logging ----------------------------------------------------------------
DISABLE_FILE_LOGGING=true

# ---- compose ----------------------------------------------------------------
# Uncomment if you use a site overlay, so the -f flags do not have to be
# repeated on every command. Omitting the overlay drops everything in it on
# the next `up -d`.
# COMPOSE_FILE=docker-compose.yml:docker-compose.site.yml

# ---- s3 backup / restore ----------------------------------------------------
# S3_PREFIX is mandatory: restore.sh reads it under `set -u`, and the image only
# defaults S3_PATH. Leaving it unset fails with an unbound variable error.
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
S3_BUCKET=change_me
S3_PREFIX=backup
S3_REGION=us-east-1
S3_ENDPOINT=change_me

# Set to encrypt backups with gpg. Must stay empty to read existing
# unencrypted .dump files -- changing it makes older backups unrestorable.
PASSPHRASE=
